# ============================================================
#  Copiez ce fichier en ".env" puis remplissez vos valeurs.
#  Le fichier ".env" ne doit JAMAIS être publié (il est dans .gitignore).
# ============================================================

# --- Site -----------------------------------------------------
PORT=3000
# Adresse publique du site (sans "/" final). Sert aux liens de partage et au sitemap.
SITE_URL=http://localhost:3000
# Mettre "false" quand les vrais produits sont en place (cache les badges "Démo").
DEMO_MODE=true
# Si le site est derrière un proxy/hébergeur (Render, Railway, Nginx...), mettre 1.
TRUST_PROXY=0

# --- Marque ---------------------------------------------------
BRAND_NAME=Petite Maille
ORDER_PREFIX=LSM
INSTAGRAM_HANDLE=cha.ima645
# Email AFFICHÉ au public dans le pied de page (optionnel, peut rester vide)
CONTACT_EMAIL=

# --- WhatsApp (UN SEUL endroit pour changer le numéro) ---------
# Format international, chiffres uniquement, sans "+" ni espaces.
# Algérie : 213 + numéro sans le 0 initial.  Ex: 0550 12 34 56  ->  213550123456
WHATSAPP_NUMBER=213550000000

# --- Livraison ------------------------------------------------
# manual     : aucun frais calculé, la créatrice les communique à la confirmation
# flat       : un tarif unique (DELIVERY_FLAT_FEE)
# per_wilaya : tarifs par wilaya, à remplir dans config/delivery-prices.js
DELIVERY_MODE=manual
DELIVERY_FLAT_FEE=0

# --- Stockage -------------------------------------------------
# Dossier où sont enregistrées les commandes (doit être persistant sur l'hébergeur !)
DATA_DIR=./storage
